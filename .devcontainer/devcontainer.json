{
    "name": "Onsite Print Backend - Python",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": false,
            "installDockerBuildx": true,
            "version": "latest",
            "dockerDashComposeVersion": "v2"
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind",
    "workspaceFolder": "${localWorkspaceFolder}",
    "remoteUser": "vscode",
    "runArgs": ["--add-host=host.docker.internal:host-gateway"],
    "remoteEnv": {
        "VIRTUAL_ENV": "/opt/onsite-print-venv",
        "PATH": "/opt/onsite-print-venv/bin:${containerEnv:PATH}"
    },
    "forwardPorts": [8000],
    "postCreateCommand": "/opt/onsite-print-venv/bin/python -m pip install --editable '.[dev]'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/onsite-print-venv/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "python.testing.pytestArgs": ["tests"]
            }
        }
    }
}
