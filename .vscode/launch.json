{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug onsite-print backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "env": {
                "DB_HOST": "postgres",
                "DB_PASSWORD_FILE": "${workspaceFolder}/../onsite-print-database/secrets/postgres_password"
            },
            "justMyCode": true
        }
    ]
}