{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Flake8",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "flake8",
                "app",
                "tests"
            ],
            "problemMatcher": "$flake8",
            "hide": true
        },
        {
            "label": "Python: mypy",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "mypy",
                "app"
            ],
            "hide": true
        },
        {
            "label": "Python: pytest",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest"
            ],
            "hide": true
        },
        {
            "label": "Python: Run checks",
            "dependsOn": [
                "Python: Flake8",
                "Python: mypy",
                "Python: pytest"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
